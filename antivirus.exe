85,\"_386\":387,\"_388\":389},\"authUi\",{\"_314\":315,\"_316\":317,\"_318\":319,\"_320\":321,\"_322\":323,\"_324\":325,\"_326\":327,\"_328\":329,\"_330\":331,\"_332\":333,\"_334\":335,\"_336\":337,\"_338\":339,\"_340\":341,\"_342\":343,\"_344\":345,\"_346\":347,\"_348\":349,\"_350\":351,\"_352\":353,\"_354\":355,\"_356\":357,\"_358\":359,\"_360\":361,\"_362\":363,\"_364\":365,\"_366\":367,\"_368\":369,\"_370\":371},\"maintenanceUi\",{\"_305\":306,\"_124\":307,\"_308\":309,\"_310\":311,\"_312\":313},\"metaTitle\",\"LimeWire | Maintenance\",\"We are under maintenance.\",\"heading\",\"We are under maintenance\",\"body\",\"LimeWire is currently undergoing maintenance and will be back shortly. Please visit us again. We're sorry for any inconvenience this may cause.\",\"tryAgain\",\"Try again\",\"devLogoAlt\",\"LimeWire Developer Logo\",\"apiTagline\",\"Free AI Studio REST APIs,{br}Powered by LimeWire\",\"signInMetaTitle\",\"Sign In | LimeWire\",\"signInHeading\",\"Sign In to LimeWire\",\"satelliteHeading\",\"Sign in or create a free account\",\"satelliteIntro\",\"{brand} is part of LimeWire. One account keeps all your transfers in one place.\",\"satelliteFreePlan\",\"Free account: links stay 7 days, 40 GB of storage, up to 20 GB per transfer\",\"satelliteFreePlanSendbig\",\"Free account: links stay 7 days, 55 GB of storage, up to 55 GB per transfer\",\"satelliteProPlan\",\"Pro: up to 250 GB per transfer (Pro+ 500 GB) and links that never expire unless you delete them\",\"failTitle\",\"Authentication Error\",\"failEmailNotFound\",\"No email was provided by the login method used. Please close this window and try again.\",\"failEmailNotValidated\",\"Your email was not validated by the login method used. Please verify your email address at your login provider and try again.\",\"failInvalidEmail\",\"Your email address contains an illegal pattern, please use a different one and try again.\",\"failGeneric\",\"The authentication was not successful. Please close this window and try again.\",\"successTitle\",\"Authentication Successful\",\"successBody\",\"The authentication was successful! You can close this window.\",\"cookieErrorTitle\",\"Authentication Cookie Error\",\"cookieErrorBody\",\"The authentication wasn't successful due to incorrect cookie propagation. Please close this window and try again.\",\"loginErrorTitle\",\"Login Error\",\"errUserNotFound\",\"We could not find a user associated with this email address.\",\"errInvalid2fa\",\"Your email code is invalid. Please try again.\",\"errInvalidTotp\",\"The code from your Authenticator app is invalid. Please try again.\",\"errWrongCredentials\",\"Incorrect email or password.\",\"errUserBlocked\",\"This account is suspended.\",\"errDomainBlacklisted\",\"Disposable email addresses are not allowed. Please contact our support team if you believe this is an error.\",\"errUserExists\",\"This user already exists.\",\"errInvalidDomain\",\"Your email contains an invalid domain, please use a different one\",\"errInvalidEmail\",\"Your email address contains an illegal pattern, please use a different one\",\"errUnexpected\",\"An unexpected error has occurred. Please try again. (\\\"{code}\\\")\",\"uploadExceedsAccountLimit\",\"The upload exceeds your account storage limit of {limit}\",\"uploadExceedsBucketLimit\",\"The upload exceeds your bucket size limit of {limit}\",\"aiActionErrorTitle\",\"AI Action Error\",\"aiActionFailed\",\"At least one AI Action failed.\",\"aiErrorInvalidLanguage\",\"The language you used is not supported by this model, please try with another.\",\"aiErrorNsfwContent\",\"Your request violates our content policy, please try again with a different prompt.\",\"aiErrorPdfNoOutput\",\"This PDF could not be processed — it may already be optimized. Please try a different file.\",\"aiErrorTimeout\",\"We couldn't finish your request in time, please try again later.\",\"aiErrorFileTooLarge\",\"This file is too large for AI tools: the limit is {limit}. Please try a smaller file.\",\"toolCategories\",{\"_654\":655,\"_656\":657,\"_658\":659,\"_660\":661,\"_662\":663,\"_664\":665,\"_666\":667},\"breadcrumb\",\"Breadcrumb\",\"themeToLight\",\"Switch to light theme\",\"themeToDark\",\"Switch to dark theme\",\"openMenu\",\"Open menu\",\"closeMenu\",\"Close menu\",\"privacyChoices\",\"Your Privacy Choices\",\"hideInfo\",\"Hide info\",\"comments\",\"Comments\",\"cardExpiry\",\"Expiry\",\"uploadFailed\",\"Upload failed. Please try again.\",\"codeSent\",\"A new code has been sent to your email.\",\"codeSentBoth\",\"A new code has been sent to both of your email addresses.\",\"fieldMin\",\"Enter at least {min} characters.\",\"fieldMax\",\"Enter no more than {max} characters.\",\"emailInvalid\",\"Enter a valid email address.\",\"researchNav\",\"Open Research section\",\"payWith\",\"Pay with\",\"confirm\",\"Confirm\",\"cancel\",\"Cancel\",\"done\",\"Done\",\"errorTitle\",\"Error\",\"somethingWrong\",\"Something went wrong.\",\"lmwrCard\",\"Card\",\"lmwrExchanges\",\"Exchanges\",\"lmwrOops\",\"Oops!\",\"lmwrReload\",\"Something went wrong. Please reload the page and try again.\",\"lmwrWertError\",\"Unexpected Wert error\",\"lmwrPaymentFailed\",\"The payment failed.\",\"lmwrCardTitle\",\"Buy LMWR with Credit Card\",\"lmwrCardIntro\",\"Powered by our partnership with Wert.io, you can instantly purchase LMWR Tokens right through your LimeWire account via credit card or Apple Pay.\",\"lmwrCardSteps\",\"To start the purchase process, please click on the button below and follow the instructions given. After your purchase is complete, your LMWR will automatically be available to use and withdraw through your LimeWire platform wallet.\",\"lmwrCardDelay\",\"Please note that after purchase completion, it may take up to 15 minutes for your LMWR to become available in your LimeWire wallet.\",\"lmwrLearnMore\",\"Learn More about LMWR\",\"lmwrPurchase\",\"Purchase Now\",\"lmwrExchangesTitle\",\"Choose your preferred exchange\",\"lmwrSuccessTitle\",\"Payment successful.\",\"lmwrSuccessBody\",\"Thank you for purchasing LMWR! Your LMWR are currently being sent to your personal LimeWire wallet. It may take up to 10 minutes for the balance to show up.\",\"lmwrGoWallet\",\"Go to my wallet\",\"stripeUnknownAction\",\"Unknown action requested\",\"stripeAuthHint\",\"Sign up for a LimeWire account or log in if you already have one.\",\"cardStatusError\",\"Couldn't retrieve credit card status\",\"addCard\",\"Add Card\",\"addCardAndPay\",\"Add Card and Pay\",\"orPayWithCard\",\"Or pay with card\",\"statementDescriptor\",\"Your card statement will show this charge as LIMEWIRE.\",\"recurringConsent\",\"By providing your card information, you authorize us to charge your card for this and future subscription payments. The service starts immediately, and subscription payments are non-refundable except where required by law.\",\"addCardTitle\",\"Add a new credit card\",\"addCardSuccess\",\"Successfully added\",\"addCardSuccessBody\",\"Your new credit card has successfully been added to your account. This card will now be the primary credit card used for your subscription payments on LimeWire.\",\"changeStatusError\",\"Couldn't retrieve subscription change status\",\"subscriptionChanged\",\"Subscription changed\",\"payPerPeriod\",\"Pay {price}/{period}\",\"payNowThen\",\"Pay {due} now, and starting {date} {price}/{period}\",\"discountedLwo\",\"(discounted by LimeWire Original)\",\"periodMonth\",\"month\",\"periodYear\",\"year\",\"periodMonthly\",\"Monthly\",\"periodAnnual\",\"Annual (save 20%)\",\"switchingTo\",\"Switching to {plan}\",\"nowOn\",\"You are now on {plan}\",\"downgradeScheduled\",\"Your current plan stays active until the end of the billing period, then the new one takes over.\",\"upgradeActive\",\"Your new plan is active right away - there is nothing else to do.\",\"selectSavedCard\",\"Select Saved Card\",\"addNewCard\",\"Add New Card\",\"cardDeleted\",\"Credit card deleted successfully.\",\"cardDeletedBody\",\"The credit card with the number {card} was deleted.\",\"deleteCardTitle\",\"Delete credit card\",\"deleteCardConfirm\",\"Please confirm that you want to remove your credit card with the number {card}.\",\"downgradeTitle\",\"Downgrade subscription\",\"downgradeBody\",\"Are you certain that you want to downgrade from your subscription? You'll lose access to all benefits of your current plan.\",\"downgradeImmediately\",\"The change will take place immediately.\",\"downgradeOn\",\"The change will take place on {date}.\",\"downgradeFilesOne\",\"Your files stop being kept forever. All of them - including the ones you upload until then - will be set to expire {days} day after the downgrade takes effect, and will be deleted once they do.\",\"downgradeFilesMany\",\"Your files stop being kept forever. All of them - including the ones you upload until then - will be set to expire {days} days after the downgrade takes effect, and will be deleted once they do.\",\"downgradeAck\",\"I understand that my files will be deleted\",\"cancelSurveyTitle\",\"Why are you leaving?\",\"cancelSurveyBody\",\"Your answer helps us make LimeWire better.\",\"cancelReasonTooExpensive\",\"It's too expensive\",\"cancelReasonUnused\",\"I don't use it enough\",\"cancelReasonMissingFeatures\",\"It's missing features I need\",\"cancelReasonSwitchedService\",\"I'm switching to another service\",\"cancelReasonTooComplex\",\"It's too hard to use\",\"cancelReasonLowQuality\",\"It doesn't work well enough\",\"cancelReasonCustomerService\",\"I'm unhappy with customer support\",\"cancelReasonOther\",\"Something else\",\"cancelCommentLabel\",\"Anything else you'd like to tell us? (optional)\",\"cancelKeepPlan\",\"Keep my plan\",\"cancelContinue\",\"Continue\",\"cancelOffersTitle\",\"Before you go\",\"cancelOfferRetentionTitle\",\"Stay and get {percent}% off your next month\",\"cancelOfferRetentionPrice\",\"{discounted} instead of {regular}\",\"cancelOfferRetentionButton\",\"Stay for {percent}% off\",\"cancelRetainedTitle\",\"You're staying on {plan}\",\"cancelRetainedText\",\"Your next payment on {date}: {discounted} instead of {regular}. After that, {regular}/month as usual.\",\"cancelRetainedDone\",\"cancelOfferRetentionError\",\"We couldn't apply the discount. Please try again.\",\"cancelOfferYearlyTitle\",\"Switch to yearly and save\",\"cancelOfferYearlyBody\",\"Pay once a year and spend less than paying month by month.\",\"cancelOfferYearlySaving\",\"Save {amount} a year\",\"cancelOfferYearlyButton\",\"Switch to yearly\",\"cancelOfferProTitle\",\"Switch to Pro\",\"cancelOfferProBody\",\"Keep the essentials for a lower price.\",\"cancelOfferProPriceMonth\",\"{price}/month instead of {regular}\",\"cancelOfferProPriceYear\",\"{price}/year instead of {regular}\",\"cancelOfferProButton\",\"cancelNoThanks\",\"No thanks, cancel my subscription\",\"keepExpiryLabel\",\"All your current files are set to never expire\",\"keepExpiryHint\",\"Untick if you want to keep their current expiration dates.\",\"invoicePaidTitle\",\"Successfully paid\",\"payAmount\",\"Pay {amount}\",\"invoicePaid\",\"Invoice paid\",\"invoicePaidBody\",\"The invoice payment was successful. Your monthly credits will be reset.\",\"selectCardRequired\",\"Please select one of the listed Credit Cards.\",\"cardsLoadFailed\",\"Could not load your saved cards. Please try again.\",\"noSavedCards\",\"No saved cards.\",\"payWithSelected\",\"Pay using the selected card\",\"paymentDeclinedTitle\",\"Payment declined\",\"paymentDeclinedHint\",\"Try another card, or contact your bank to find out why the payment was declined.\",\"paymentFundsTitle\",\"Not enough funds on the card\",\"paymentFundsHint\",\"Top up the card or try another one.\",\"paymentExpiredTitle\",\"Card expired\",\"paymentExpiredHint\",\"Check the expiry date or use another card.\",\"paymentCvcTitle\",\"Wrong security code\",\"paymentCvcHint\",\"Check the 3-digit code on the back of the card and try again.\",\"paymentNumberTitle\",\"Wrong card number\",\"paymentNumberHint\",\"Check the card number and try again.\",\"paymentProcessingTitle\",\"The payment did not go through\",\"paymentProcessingHint\",\"Please try again in a few minutes.\",\"paymentAuthTitle\",\"Payment not confirmed\",\"paymentAuthHint\",\"The confirmation with your bank was not completed. Try again and finish it in the bank window, or use another card.\",\"chooseSubscription\",\"Choose your Subscription\",\"upgradeSubscription\",\"Upgrade your Subscription\",\"image\",\"Image Tools\",\"pdf\",\"PDF Tools\",\"video\",\"Video Tools\",\"audio\",\"Audio Tools\",\"developer\",\"Developer Tools\",\"gaming\",\"Gaming Tools\",\"ai\",\"AI Tools\",\"errorCode\",\"Error {status}\",\"authRequired\",\"To perform this action, please sign up for a free LimeWire account or log in if you already have one.\",\"upgradeRequired\",\"Please upgrade your plan to perform this action.\",\"upgradeLink\",\"Upgrade your plan\",\"upgradeToContinue\",\"{link} to continue.\",\"logout\",\"Logout\",\"verifyHuman\",\"Verify you are human\",\"verificationError\",\"Verification Error\",\"verificationLoadFailed\",\"Verification couldn't be loaded.\",\"verificationNotConfigured\",\"Verification is not configured.\",\"noticeStorageBlocked\",\"This browser is not letting LimeWire save data. Files uploaded without an account disappear after a reload.\",\"noticeLargeDownloads\",\"Large downloads are unavailable. Finish transfers, then reload this page.\",\"noticeUpdate\",\"Update available. Close all LimeWire tabs, then reopen LimeWire.\",\"myWallet\",\"My Wallet\",\"tokenMenu\",\"Open LMWR menu\",\"tokenBalance\",\"LimeWire Token:\",\"paymentFailedTitle\",\"Your last payment for {plan} didn't go through.\",\"paymentFailedText\",\"Pay the open invoice to keep your plan, otherwise your account moves to the Free plan.\",\"planEndingTitle\",\"Your {plan} plan ends on {date}.\",\"planEndingText\",\"After that your account moves to the Free plan.\",\"deletedOne\",\"Your files are deleted {count} day later.\",\"deletedOther\",\"Your files are deleted {count} days later.\",\"payNow\",\"Pay now\",\"keepPlan\",\"Keep {plan}\",\"hide\",\"Hide for now\",\"navProducts\",\"Products\",\"navMore\",\"More\",\"navBuyLmwr\",\"Buy LMWR\",\"navTokenPrice\",\"{token} price\",\"showInfo\",\"Show Info\",\"uploadDropFiles\",\"Drag and Drop file(s) here\",\"uploadSelectFolder\",\"Or select a folder\",\"uploadCreateWithAi\",\"Create with AI\",\"uploadFilesButton\",\"Upload Files\",\"uploadDone\",\"uploadCancel\",\"uploadCanceled\",\"The upload was canceled\",\"limitUpToFree\",\"Up to {limit} free\",\"limitUpTo\",\"Up to {limit}\",\"limitNone\",\"No Upload Size Limit\",\"limitIncrease\",\"Increase Limit\",\"bucketExpiresIn\",\"Expires in\",\"bucketNoExpiry\",\"No Expiry\",\"bucketViewsCount\",\"Views: {count}\",\"bucketDownloadsCount\",\"Downloads: {count}\",\"bucketFileOne\",\"{count} File\",\"bucketFileMany\",\"{count} Files\",\"bucketByAgent\",\"AI agent\",\"bucketByAgentHint\",\"Added by an AI agent through the LimeWire MCP server\",\"bucketShare\",\"Share\",\"bucketDownloadAll\",\"Download All\",\"bucketTools\",\"Tools\",\"sidebarUpsell\",\"Need larger uploads \u0026 longer expirations?\",\"sidebarUpgrade\",\"Upgrade\",\"sidebarFreeCredits\",\"Free AI Credits\",\"sidebarCreditsPerWeek\",\"{count} credits / week\",\"sidebarCreditsHelp\",\"Credits are used for creating content with AI, editing and manipulating your files with AI, and other file manipulation tools on LimeWire.\",\"sidebarCreateAccount\",\"Create Account\",\"sidebarBalance\",\"Credit Balance\",\"sidebarCreditsRemaining\",\"{count} credits remaining\",\"sidebarBalanceHelp\",\"Your credit balance refills every monday and can be used for creating content with AI, editing and manipulating your files with AI, and other file manipulation tools on LimeWire.\",\"anonymousNotice\",\"As an anonymous user, your files expire after 3 days and downloads are limited. Create a free LimeWire account to keep your files for 7 days and get twice as many downloads, or upgrade a plan to keep them for longer.\",\"claimReady\",\"Your files are ready!\",\"claimTitle\",\"Your files are ready! {brand} is now part of LimeWire.\",\"claimDescription\",\"Your files have successfully been uploaded. You can now add additional files here or share your files by clicking on the „Share“ button below.\",\"shareWithLink\",\"Share with Link\",\"shareCopyHint\",\"Simply copy your download link below to share your files.\",\"shareSendEmail\",\"Send via E-Mail\",\"shareSendEmailButton\",\"Send E-Mail\",\"shareEmailPlaceholder\",\"Enter e-mail address\",\"sharePermission\",\"Permission\",\"shareEmailSent\",\"E-Mail Sent\",\"shareStop\",\"Stop Sharing\",\"shareStopNotice\",\"Once you stop sharing your files, all previously generated download links will no longer work.\",\"transfers\",\"Transfers\",\"transfersCollapse\",\"Collapse Transfers\",\"transfersClear\",\"Clear and close transfers\",\"decrypting\",\"Decrypting\",\"generating\",\"Generating...\",\"menuRename\",\"Rename\",\"menuDelete\",\"Delete\",\"menuDetails\",\"Details\",\"menuPin\",\"Pin\",\"menuUnpin\",\"Unpin\",\"menuCopyFiles\",\"Copy Files\",\"menuMoveFiles\",\"Move Files\",\"menuAddFiles\",\"Add Files\",\"menuSelectAll\",\"Select all\",\"menuUnselectAll\",\"Unselect all\",\"menuOpenFile\",\"Open File\",\"menuDownload\",\"Download\",\"menuNext\",\"Next\",\"menuPrevious\",\"Previous\",\"menuRetry\",\"Retry\",\"menuUpgradePlan\",\"menuNoTools\",\"There are no tools available for your file types.\",\"uploadFilesMenu\",\"Upload files\",\"uploadFolderMenu\",\"Upload folder\",\"pasteFromClipboard\",\"Paste from clipboard\",\"pastePlaceholder\",\"Paste your text here...\",\"confirmClose\",\"Close\",\"confirmDeleteFile\",\"Delete File\",\"confirmDeleteBucket\",\"Delete Bucket\",\"confirmDeleteBucketPrefix\",\"The bucket\",\"confirmDeleteBucketSuffix\",\"will be deleted. This process is not reversible.\",\"confirmDeleteFileNotice\",\"The file will be deleted. This process is not reversible.\",\"renameFile\",\"Rename File\",\"renameBucket\",\"Change Name\",\"feedActivity\",\"My Activity\",\"feedLoading\",\"Loading Activity...\",\"feedEnd\",\"You reached the end of the list.\",\"searchPlaceholder\",\"Search...\",\"errorUpload\",\"Upload Error\",\"errorDownload\",\"Download Error\",\"errorPreview\",\"Unable to load preview.\",\"previewUnsupportedFormat\",\"Your browser can't play this format. Download the file to open it.\",\"previewTooLarge\",\"Preview is available for files up to {size}. Download the file instead.\",\"textPreviewTruncated\",\"Showing the first {size} of the file. Download it to see the rest.\",\"officePreviewTruncated\",\"Showing only the beginning of the file. Download it to see everything.\",\"previewViewTable\",\"Table\",\"previewViewText\",\"Text\",\"errorDisplayFile\",\"An error occurred while displaying the file.\",\"advancedSettings\",\"Advanced Settings\",\"aiModel\",\"Model\",\"aiModelHint\",\"Different AI models can produce different or better results so feel free to experiment.\",\"caution\",\"Caution!\",\"change\",\"Change\",\"changeName\",\"close\",\"confirmation\",\"Confirmation\",\"delete\",\"deleteFileTitle\",\"deleteFileWarning\",\"disable\",\"Disable\",\"Download all\",\"e2eeChangedSuccess\",\"You successfuly changed your end-to-end encryption passphrase.\",\"e2eeDisableTitle\",\"Disable End-To-End encryption\",\"e2eeDisabledSuccess\",\"You successfully disabled end-to-end encryption for your account.\",\"e2eeEnableTitle\",\"Enable End-To-End encryption\",\"e2eeEnabledSuccess\",\"You successfully enabled end-to-end encryption for your account.\",\"e2eePassphraseTitle\",\"End-To-End encryption passphrase\",\"e2eeResetDataWarning\",\"ALL YOUR UPLOADED DATA WILL BE DELETED.\",\"e2eeResetSuccess\",\"You successfully reset end-to-end encryption for your account.\",\"e2eeResetTitle\",\"Reset End-To-End encryption\",\"enable\",\"Enable\",\"errorDisplayFileHint\",\"The file could not be displayed. Please download it instead.\",\"fileEmpty\",\"This file is empty\",\"fileName\",\"File name\",\"next\",\"noActivity\",\"You do not have any activity\",\"noActivityHint\",\"Upload a file above or create content with AI to get started.\",\"noSearchResults\",\"No search results\",\"passphrase\",\"Passphrase\",\"passphraseChangeTitle\",\"Change passphrase\",\"passphraseCurrent\",\"Current Passphrase\",\"passphraseEnterChosenHint\",\"Enter the passphrase you chose for the end-to-end encryption.\",\"passphraseEnterCurrentHint\",\"Enter the current passphrase for the end-to-end encryption.\",\"passphraseEnterHint\",\"Enter the passphrase for the end-to-end encryption.\",\"passphraseEnterNewHint\",\"Enter the new passphrase for the end-to-end encryption.\",\"passphraseForgotten\",\"I have forgotten my passphrase.\",\"passphraseHide\",\"Hide Passphrase\",\"passphraseHideCurrent\",\"Hide Current Passphrase\",\"passphraseHideNew\",\"Hide New Passphrase\",\"passphraseHideRepeat\",\"Hide Repeated Passphrase\",\"passphraseLossWarning\",\"If you forget your passphrase, there's no way to recover your data.\",\"passphraseManagerHint\",\"We recommend that you store it in a password manager.\",\"passphraseNew\",\"New Passphrase\",\"passphraseRepeat\",\"Repeat Passphrase\",\"passphraseRepeatHint\",\"Repeat the passphrase for verification.\",\"passphraseRepeatNew\",\"Repeat New Passphrase\",\"passphraseRepeatNewHint\",\"Repeat the new passphrase for verification.\",\"passphraseSecurityNote\",\"Your data is only as secure as your passphrase.\",\"passphraseShow\",\"Show Passphrase\",\"passphraseShowCurrent\",\"Show Current Passphrase\",\"passphraseShowNew\",\"Show New Passphrase\",\"passphraseShowRepeat\",\"Show Repeated Passphrase\",\"passphraseStrongHint\",\"Please use a sufficiently long and complex passphrase.\",\"previous\",\"rename\",\"renameFilePrompt\",\"Please enter a new file name:\",\"renameFileTitle\",\"reset\",\"Reset\",\"retry\",\"search\",\"searchEmpty\",\"Your search for \\\"{filter}\\\" yielded no results.\",\"success\",\"Success\",\"totpEnableTitle\",\"Enable Authenticator app\",\"totpEnableSuccess\",\"You successfully enabled an Authenticator app for your account. For security reasons you will be signed out.\",\"totpQrAlt\",\"QR Code\",\"totpScanHint\",\"Use an Authenticator app or browser extensions to scan the QR code.\",\"totpManualHint\",\"If scanning the above QR Code does not work, try entering the following code manually:\",\"totpHideSecret\",\"Hide Secret\",\"totpShowSecret\",\"Show Secret\",\"totpLossWarning\",\"If you lose access to your authenticator codes, you will not be able to login to your account anymore.\",\"totpDisableTitle\",\"Remove Authenticator app\",\"totpDisableSuccess\",\"You successfully removed your Authenticator app from your account.\",\"totpDisableConfirm\",\"Are you sure you want to remove your Authenticator app?\",\"totpDisableWarning\",\"Disabling the Authenticator app removes an essential layer of security, leaving your account vulnerable. Without it, anyone with access to your email can access your LimeWire account.\",\"remove\",\"Remove\",\"newEmailLabel\",\"New Email Address\",\"changeEmailButton\",\"Change email address\",\"emailChanged\",\"Your email has been changed successfully to: \\\"{email}\\\".\",\"codeSentToEmail\",\"Enter 6-digit code sent to your email: \\\"{email}\\\".\",\"codeSentToNewEmail\",\"Enter 6-digit code sent to your new email: \\\"{email}\\\".\",\"Page Not Found\",\"notFoundText\",\"The link you followed may be broken, or the page may have been removed.\",\"goneTitle\",\"This Link No Longer Works\",\"goneText\",\"The files behind this link are gone. A share stops working once the person who created it deletes the files or the link expires.\",\"serverTitle\",\"Oops! Something went wrong\",\"serverText\",\"Click the back button to keep exploring. We apologize for any inconvenience caused.\",\"Unknown Error\",\"backHome\",\"Go back to home\",\"goneOffer\",\"Upload your files and get a share link in seconds — free, no account needed, up to {anonSize} GB.\",\"goneCta\",\"Upload your files\",\"goneSendTitle\",\"Send your own files\",\"goneAskSender\",\"Still need these files? Ask the person who sent you the link to share them again.\",\"goneSenderTitle\",\"Was this your link?\",\"goneSenderText\",\"Links shared without an account expire after {anonDays} days. Sign up for free and your links stay live for {freeDays} days, with up to {freeSize} GB per transfer. With PRO, links never expire.\",\"goneSenderCta\",\"Create a free account\",\"gonePlansLink\",\"Compare plans\",\"modalTitle\",\"Sign In or Create Account\",\"uploadInProgressTitle\",\"Your upload is still running\",\"uploadInProgressText\",\"Signing in now would stop it, and the files would not be saved. You can enter your email and get the code already — signing in unlocks as soon as the upload finishes.\",\"uploadInProgressOverride\",\"Sign in anyway and stop the upload\",\"continue\",\"continueWithEmail\",\"Continue with Email\",\"continueWithGoogle\",\"Continue with Google\",\"continueWithDiscord\",\"Continue with Discord\",\"continueWithWallet\",\"Continue with Wallet\",\"or\",\"Email\",\"emailPlaceholder\",\"Email Address\",\"codeEmailLabel\",\"E-Mail Authentication Code\",\"codeEmailHint\",\"Enter 6-digit code sent to your email\",\"codeNewEmailLabel\",\"Authentication Code (New Email)\",\"codeNewEmailHint\",\"Enter 6-digit code sent to your new email\",\"codeAppLabel\",\"Authenticator App Code\",\"codeAppHint\",\"Enter 6-digit code from your Authenticator App\",\"codeSentToPrefix\",\"Enter 6-digit code sent to\",\"resendCode\",\"Send a new E-Mail code\",\"walletFirstTime\",\"You are using this wallet to sign in for the first time. Please enter your e-mail to continue.\",\"newsletterConsent\",\"I agree to receive product updates, tips, and special offers from LimeWire by email.\",\"closeWindow\",\"Close Window\",\"errorCodeRequired\",\"Authentication code is required.\",\"errorCodeLength\",\"The Authentication code is 6 characters long.\",\"errorEmailRequired\",\"Email is required.\",\"walletConnecting\",\"Initiating a connection to your wallet.\",\"walletTakesSeconds\",\"This can take a few seconds...\",\"walletNotConnected\",\"Wallet not connected.\",\"walletNotConnectedDetail\",\"We couldn't connect to your wallet, please make sure your wallet is connected to the site and is using the correct account.\",\"walletCheckWallet\",\"Please check your wallet.\",\"walletSignPrompt\",\"You will be asked to sign a message in order to authenticate. This won't cost any gas.\",\"walletNoSignature\",\"Signature not obtainable.\",\"walletNoSignatureDetail\",\"We couldn't obtain the signature from your wallet. You may have rejected the action in your wallet.\",\"walletVerifying\",\"Verifying your signature.\",\"button\",\"Language\",\"Choose your language\",\"apply\",\"LimeWire {terms} and {privacy} apply.\",\"recaptcha\",\"This site is protected by reCAPTCHA and the Google {privacy} and {terms} apply.\",\"googlePrivacy\",\"Privacy Policy\",\"googleTerms\",\"Terms of Service\",\"signIn\",\"Sign In\",\"createAccount\",\"Pricing\",\"tools\",\"about\",\"About LimeWire\",\"blog\",\"Blog\",\"helpCenter\",\"Help Center\",\"terms\",\"Terms \u0026 conditions\",\"privacy\",\"index\",\"Home\",\"buyLmwr\",\"mcpServer\",\"MCP Server\",\"history\",\"Our History\",\"research\",\"Open Research\",\"press\",\"Press\",\"writeForUs\",\"Write for Us\",\"userSubscription\",\"Subscription\",\"userPayments\",\"Payments\",\"userProfile\",\"My Profile\",\"userSettings\",\"Settings\",\"userFiles\",\"My Files\",\"descLimeWire\",\"Upload, edit \u0026 share files of any size\",\"descLmwr\",\"LimeWire ecosystem utility token\",\"descLimeWireNetwork\",\"Decentralized file storage network\",\"descLmwrScan\",\"Real-time LimeWire Network analytics\",\"lmwrToken\",\"LimeWire Token\",\"footerResources\",\"Resources\",\"footerCompany\",\"Company\",\"footerAccount\",\"Account\",\"footerTaglineBrand\",\"The New LimeWire.\",\"footerTaglineMotto\",\"Create. Collaborate. Share.\",\"menuProduct\",\"Product\",\"menuCommunity\",\"Community\",\"allTools\",\"All Tools\",\"support\",\"Support\",\"badgeNew\",\"New\",\"logoAlt\",\"LimeWire Logo\",\"avatarAlt\",\"User Avatar\",\"splashAlt\",\"LimeWire Splash Icon\",\"Pricing | LimeWire — File Sharing Plans\",\"Compare LimeWire plans: upload size, storage, how long files stay online and daily download limits. Start free, upgrade when you need more.\",\"LimeWire Pricing\",\"subtitle\",\"Share and store files with end-to-end encryption. Start on the free plan and upgrade only when you need bigger uploads, more storage or files that stay online longer.\",\"free\",\"Free\",\"perMonth\",\"/month\",\"billedYearly\",\"or {price} billed yearly\",\"saving\",\" — save {percent}%\",\"ctaFree\",\"ctaPaid\",\"Get {plan}\",\"note\",\"Prices are in US dollars. You can change or cancel your plan at any time in your account settings.\",\"faqHeading\",\"Frequently asked questions\",\"q1\",\"Can I share files without an account?\",\"a1\",\"Yes. You can upload and share a file without signing up, with the limits of the free plan. An account keeps your files in one place and raises the daily download limit.\",\"q2\",\"What happens to my files after they expire?\",\"a2\",\"Shared files stay online for the period shown on your plan and are then removed, so old links stop working. Paid plans keep files online longer and let you pin uploads that should never expire.\",\"q3\",\"Is there a download limit?\",\"a3\",\"Every plan has one. Each of your files can be downloaded a set number of times per day, and that number is listed on each plan above. All downloads of your files together also have a size limit per day and per month, listed on each plan too: the daily one resets at 00:00 UTC, the monthly one on the 1st of the month.\",\"q4\",\"Are my files encrypted?\",\"a4\",\"Yes, on every plan, including the free one. Files are encrypted and only someone with your link can open them.\",\"q5\",\"Can I cancel at any time?\",\"a5\",\"Yes. A plan can be changed or cancelled in your account settings, and no further payment is taken after that.\",\"tierFreeNote\",\"Share files once in a while\",\"tierFreeSendbigNote\",\"SendBig bonus: up to {size} per transfer\",\"tierProNote\",\"Share \u0026 edit big files regularly\",\"tierProPlusNote\",\"Share \u0026 store big files at scale\",\"featUpload\",\"Upload up to {size}\",\"featUploadFiles\",\"Upload up to {count} files a day\",\"featStorage\",\"{size} Storage\",\"featNeverExpire\",\"Files never expire\",\"featExpire\",\"Files expire after {period}\",\"featDownloads\",\"Each file can be downloaded up to {count} times a day\",\"featDownloadsTip\",\"Each of your files can be downloaded up to {count} times per day, with a total of {total} of downloads per month.\",\"featEgress\",\"Up to {daily} of Downloads Daily, {monthly} Monthly\",\"featEgressTip\",\"The total size of all downloads of your files. The daily limit resets at 00:00 UTC, the monthly one on the 1st of the month.\",\"featEncryption\",\"Full Encryption\",\"featTools\",\"File Editing Tools\",\"featPinned\",\"{count} Pinned Uploads\",\"featPinnedTip\",\"Pinned uploads always stay on top of your feed and never expire.\",\"unitDay\",\"{count} day\",\"unitDays\",\"{count} days\",\"unitMonth\",\"{count} month\",\"unitMonths\",\"{count} months\",\"What is LimeWire?\",\"LimeWire is a file sharing platform. You drop a file in, you get a link, you send the link — no software to install and no account needed to start. Alongside sharing it runs AI tools for images, video and documents. It is the same name as the peer-to-peer client of the 2000s and the same idea — moving files between people — rebuilt as a service that runs in a browser.\",\"Is LimeWire still around?\",\"Yes. LimeWire is live and in daily use: 131 million files have been shared through it and 7.6 petabytes uploaded. The original peer-to-peer network shut down in 2010; the name came back in 2022 as the file sharing and AI platform you are looking at now.\",\"Is LimeWire safe to use?\",\"Files are encrypted before they leave your device and stay encrypted in storage. If you share without an account, the key stays on your device and is carried in the link itself — so nobody, including us, can open the file without the link you sent. There is nothing to install, so there is no installer to pick up anything on the way.\",\"Do I need an account to share a file?\",\"No. Without an account you can send up to 10 GB at a time and the link stays live for 3 days. A free account raises that to 20 GB per transfer with links that stay live for 7 days, and gives you 40 GB of storage; paid plans go up to 500 GB per transfer with no expiry date on the link.\",\"How large a file can I send?\",\"Up to 10 GB per transfer without an account, 20 GB on the free plan, 250 GB on Pro and 500 GB on Pro+. There is no file type restriction — video, archives, design files and raw footage all go through the same way.\",\"q6\",\"How long do my files stay online?\",\"a6\",\"Seven days on the free plan and three days for anonymous uploads, counted from the moment the upload finishes. On Pro and Pro+ links do not expire on their own, and you can set an expiry date yourself when you want one.\",\"q7\",\"Is LimeWire free?\",\"a7\",\"Yes, sharing files is free and stays free. Paid plans exist for people who need bigger transfers, more storage, longer-lived links and more AI credits — the full breakdown is on the pricing page.\",\"link7\",\"See all plans and prices\",\"q8\",\"What happened to the original LimeWire?\",\"a8\",\"A US court ordered the file-sharing features switched off on 26 October 2010, after a lawsuit brought by thirteen record companies in 2006. Lime Wire LLC settled in 2011 and no longer operates the brand: the LimeWire name was acquired in 2022 by a different company, which rebuilt the product from scratch as a web service. Nothing of the original peer-to-peer network was carried over.\",\"link8\",\"Read the full history of LimeWire, 2000 to today\",\"cta\",\"hintLine1\",\"Click or drag-and-drop\",\"hintLine2\",\"your files here\",\"folder\",\"titleHighlight\",\"Upload, edit and share\",\"titleRest\",\"files of any size\",\"Our end-to-end encrypted, AI-powered file sharing platform allows you to upload, manipulate \u0026 share files of any size, on any device.\",\"statsFiles\",\"Files Shared\",\"statsFilesValue\",\"131 Million\",\"statsUploaded\",\"Uploaded\",\"statsUploadedValue\",\"7.6 Petabyte\",\"statsRating\",\"Avg. Rating\",\"capterraNote\",\"Capterra Shortlist reports constitute the subjective opinions of individual end-user reviews, ratings and data applied against a documented methodology; they neither represent the views of, nor constitute an endorsement by, Capterra or its affiliates.\",\"rights\",\"All Rights Reserved.\",\"title\",\"LimeWire — Upload, edit and share files of any size\",\"description\",\"End-to-end encrypted file sharing with AI tools. Send files of any size from any device, no account needed to start.\",\"headingUpload\",\"Share files with LimeWire\",\"currency\",\"LMWR\",\"exchangeRate\",0.00616915716350103,\"percentageChange24h\",-3.575727411783,\"NOW\",[\"D\",1795599728876],\"CLIENT_BASE_URL\",\"https://limewire.com\",\"IS_DEV\",\"IS_STAGING\",\"API_BASE_URL\",\"https://api.limewire.com\",\"CANONICAL_BASE_URL\",\"SENTRY_DSN\",\"https://3914d239cc544007a8bc3b33c2e276e7@o4505008135340032.ingest.sentry.io/4505114707099648\",\"SENTRY_ENVIRONMENT\",\"production\",\"SENTRY_PROJECT\",\"limewire-js-remix\",\"GIT_RELEASE\",\"3fbadb6df8a8bbdba5576e94fa265a0aede9fdab\",\"TURNSTILE_SITEKEY\",\"0x4AAAAAAEVmA3xwky6ar3WJ\"]\n");</script><!--$--><script>window.__reactRouterContext.streamController.close();</script><!--/$--><!--/$--></body></html>